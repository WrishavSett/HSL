# Virtual environment — dependencies are installed fresh inside the image
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary rasterised images — ephemeral, not part of the image
temp/

# Secrets — passed in at runtime via --env-file or docker-compose env_file
.env
*.env

# Version control
.git/
.gitignore

# Editor / OS artefacts
.DS_Store
*.swp
Thumbs.db
